<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <RootNamespace>NcseaHackathon</RootNamespace>
    <AssemblyName>NcseaHackathon</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit 2027</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <RevitAddinsFolder>$(AppData)\Autodesk\Revit\Addins\2027</RevitAddinsFolder>
  </PropertyGroup>

  <Target Name="CopyToRevitAddins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevitAddinsFolder)" />
    <Copy SourceFiles="$(ProjectDir)NcseaHackathon.addin" DestinationFolder="$(RevitAddinsFolder)" />
  </Target>

</Project>
